datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TaxRegime {
  AUTO_ENTREPRENEUR
  FORFAITAIRE
  REEL
}

enum UserRole {
  OWNER
  MEMBER
  ADMIN
  USER
  DEMO
}

enum InvoiceStatus {
  DRAFT
  SENT
  AWAITING_PAYMENT
  PAYMENT_CLAIMED
  PAID
  OVERDUE
  DISPUTED
  CANCELLED
}

enum PaymentProofStatus {
  SUBMITTED
  CONFIRMED
  REJECTED
}

model Organization {
  id                  String    @id @default(uuid())
  name                String
  ownerUserId         String?
  activityType        String?
  taxRegime           TaxRegime @default(AUTO_ENTREPRENEUR)
  vatRegistered       Boolean   @default(false)
  taxId               String? // Matricule Fiscal or Auto-entrepreneur identifier
  address             String?
  city                String?
  postalCode          String?
  country             String    @default("Tunisia")
  phone               String?
  email               String?
  website             String?
  bankName            String?
  bankRib             String? // Relevé d'Identité Bancaire (20 digits in Tunisia)
  bankIban            String?
  bankBic             String?
  stampImageUrl       String?
  signatureImageUrl   String?
  logoUrl             String?
  invoicePrefix       String    @default("FAC")
  invoiceCounter      Int       @default(0)
  currency            String    @default("TND")
  defaultVatRate      Float     @default(19.0)
  defaultPaymentTerms String?
  plan                String    @default("FREE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  users         User[]
  clients       Client[]
  invoices      Invoice[]
  paymentProofs PaymentProof[]
  chatSessions  ChatSession[]

  @@map("organizations")
}

model User {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  email          String        @unique
  fullName       String?
  phone          String?
  passwordHash   String?
  streetAddress  String?
  city           String?
  state          String?
  postalCode     String?
  country        String?       @default("Tunisia")
  role           UserRole      @default(OWNER)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  chatSessions ChatSession[]

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

model Client {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  companyName    String?
  email          String?
  phone          String?
  address        String?
  city           String?
  postalCode     String?
  country        String?      @default("Tunisia")
  taxId          String? // Client's Matricule Fiscal for B2B invoices
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invoices Invoice[]

  @@index([organizationId])
  @@index([organizationId, email])
  @@map("clients")
}

model Invoice {
  id                 String        @id @default(uuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber      String // e.g. FAC-2026-0001
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  currency           String        @default("TND")
  vatApplicable      Boolean       @default(false)
  vatRate            Float         @default(0.0)
  subtotal           Float         @default(0.0) // Montant Hors Taxe (HT)
  vatAmount          Float         @default(0.0) // Montant TVA
  timbreFiscalAmount Float         @default(1.000) // Droit de timbre fiscal (1.000 DT)
  total              Float         @default(0.0) // Total TTC
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  status             InvoiceStatus @default(DRAFT)
  publicToken        String        @unique @default(uuid())
  pdfUrl             String?
  mdContent          String?
  notes              String?
  paymentTerms       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items         InvoiceItem[]
  paymentProofs PaymentProof[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, invoiceNumber])
  @@index([publicToken])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1.0)
  unitPrice   Float    @default(0.0)
  vatRate     Float    @default(0.0)
  total       Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_items")
}

model PaymentProof {
  id              String             @id @default(uuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fileUrl         String
  amount          Float?
  notes           String?
  rejectionReason String?
  status          PaymentProofStatus @default(SUBMITTED)
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payment_proofs")
}

model ChatSession {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String        @default("New Invoice Discussion")
  messages       Json          @default("[]")
  draftInvoice   Json?
  status         String        @default("active")
  invoiceId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@map("chat_sessions")
}

model Review {
  id        String   @id @default(uuid())
  name      String
  company   String?
  rating    Int
  title     String?
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("reviews")
}
